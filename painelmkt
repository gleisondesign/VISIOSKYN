<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MindFly — Painel de Keywords</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:          #0D0D0D;
    --surface:     #181818;
    --surface2:    #222222;
    --line:        rgba(255,255,255,0.07);
    --orange:      #FF6200;
    --orange-dim:  rgba(255,98,0,0.12);
    --orange-glow: rgba(255,98,0,0.22);
    --white:       #F2F2F2;
    --muted:       #777;
    --muted2:      #555;
    --hot-text:    #FFAA70;
    --mid-text:    #70C4FF;
    --low-text:    #888;
    --neg-text:    #FF8080;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    height: 100%;
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--white);
    overflow: hidden;
  }

  /* ─── LOGIN ───────────────────── */
  #login-screen {
    position: fixed; inset: 0;
    background: var(--bg);
    display: flex; align-items: center; justify-content: center;
    z-index: 100;
    transition: opacity .45s ease, transform .45s ease;
  }
  #login-screen.hide { opacity: 0; transform: scale(1.05); pointer-events: none; }
  .login-box {
    width: 100%; max-width: 370px; margin: 20px;
    background: var(--surface);
    border: 1px solid rgba(255,98,0,.2);
    border-radius: 20px;
    padding: 42px 34px 38px;
    box-shadow: 0 0 80px rgba(255,98,0,.06), 0 40px 80px rgba(0,0,0,.6);
    text-align: center;
  }
  .login-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 54px; height: 54px;
    background: var(--orange-dim);
    border: 1px solid rgba(255,98,0,.3);
    border-radius: 14px;
    font-size: 1.5rem; margin-bottom: 18px;
  }
  .login-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800; font-size: 1.5rem;
    color: var(--white); margin-bottom: 4px;
  }
  .login-title span { color: var(--orange); }
  .login-subtitle { font-size: .8rem; color: var(--muted); margin-bottom: 30px; }
  .login-label {
    display: block; text-align: left;
    font-size: .68rem; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--muted); margin-bottom: 8px;
  }
  .login-input {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 13px 16px;
    color: var(--white);
    font-family: 'DM Sans', sans-serif; font-size: .95rem;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
    margin-bottom: 8px;
  }
  .login-input:focus { border-color: var(--orange); box-shadow: 0 0 0 3px var(--orange-dim); }
  .login-error { font-size: .75rem; color: #FF5555; height: 16px; margin-bottom: 14px; }
  .login-btn {
    width: 100%; background: var(--orange); border: none;
    border-radius: 10px; padding: 14px;
    color: #fff; font-family: 'Syne', sans-serif;
    font-weight: 700; font-size: .95rem;
    cursor: pointer;
    transition: background .2s, box-shadow .2s, transform .1s;
    box-shadow: 0 6px 28px var(--orange-glow);
  }
  .login-btn:hover { background: #e05500; }
  .login-btn:active { transform: scale(.98); }

  /* ─── DASHBOARD ───────────────── */
  #dashboard { display: none; flex-direction: column; height: 100vh; overflow: hidden; }
  #dashboard.visible { display: flex; }

  /* Header */
  .header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    height: 54px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 18px; position: relative;
  }
  .header::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--orange), transparent);
    opacity: .4;
  }
  .brand { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.15rem; }
  .brand span { color: var(--orange); }
  .header-tag {
    font-size: .66rem; letter-spacing: 1.2px; text-transform: uppercase;
    color: var(--muted); background: var(--surface2);
    border: 1px solid var(--line); border-radius: 20px; padding: 4px 12px;
  }

  /* ─── PILL NAV ─────────────────── */
  .pill-nav {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 11px 14px; flex-shrink: 0;
  }
  /* Mobile: 2+2 grid, "Visão Geral" full-width on its own row */
  .pill-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
  }
  .pill-overview { grid-column: 1 / -1; }

  /* Desktop: all 5 side by side */
  @media (min-width: 600px) {
    .pill-grid { grid-template-columns: repeat(5, 1fr); }
    .pill-overview { grid-column: auto; }
  }

  .pill-btn {
    background: var(--surface2);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 9px 8px;
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
    font-weight: 500; font-size: .78rem;
    cursor: pointer; text-align: center;
    transition: background .2s, border-color .2s, color .2s;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .pill-btn.active {
    background: var(--orange-dim);
    border-color: rgba(255,98,0,.45);
    color: var(--orange); font-weight: 600;
  }
  .pill-btn:hover:not(.active) { border-color: var(--muted2); color: var(--white); }

  /* ─── CONTENT ──────────────────── */
  .content {
    flex: 1; overflow-y: auto;
    padding: 16px 15px 28px;
    scrollbar-width: thin;
    scrollbar-color: var(--surface2) transparent;
  }
  .content::-webkit-scrollbar { width: 3px; }
  .content::-webkit-scrollbar-track { background: transparent; }
  .content::-webkit-scrollbar-thumb { background: var(--surface2); border-radius: 4px; }

  .tab-panel { display: none; animation: fadeUp .28s ease; }
  .tab-panel.active { display: block; }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Panel header */
  .panel-header { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
  .panel-icon {
    width: 44px; height: 44px; flex-shrink: 0;
    background: var(--orange-dim);
    border: 1px solid rgba(255,98,0,.25);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem;
  }
  .panel-title { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.2rem; line-height: 1.1; }
  .panel-title span { color: var(--orange); }
  .panel-desc { font-size: .76rem; color: var(--muted); margin-top: 4px; line-height: 1.45; }

  /* Stats */
  .stats-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; margin-bottom: 14px; }
  .stat-chip {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 6px;
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    text-align: center;
  }
  .s-icon { font-size: .95rem; }
  .s-num { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1.1rem; color: var(--orange); }
  .s-label { font-size: .6rem; color: var(--muted); text-transform: uppercase; letter-spacing: .6px; line-height: 1.2; }

  /* KW sections */
  .kw-section { margin-bottom: 12px; }
  .kw-section-title {
    font-size: .65rem; letter-spacing: 1.8px;
    text-transform: uppercase; color: var(--muted2);
    margin-bottom: 8px;
    display: flex; align-items: center; gap: 8px;
  }
  .kw-section-title::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .kw-grid { display: flex; flex-wrap: wrap; gap: 7px; }
  .kw-tag {
    font-size: .79rem; font-weight: 500;
    padding: 6px 11px; border-radius: 8px;
    border: 1px solid transparent;
    transition: transform .15s; line-height: 1.3;
  }
  .kw-tag:hover { transform: translateY(-2px); }
  .kw-tag.hot  { background: rgba(255,98,0,.1);   border-color: rgba(255,98,0,.28);  color: var(--hot-text); }
  .kw-tag.mid  { background: rgba(50,130,200,.1); border-color: rgba(50,130,200,.25);color: var(--mid-text); }
  .kw-tag.low  { background: rgba(255,255,255,.04); border-color: var(--line);        color: var(--low-text); }

  /* Negatives */
  .neg-section {
    background: rgba(255,60,60,.04);
    border: 1px solid rgba(255,60,60,.14);
    border-radius: 12px; padding: 12px 13px; margin-top: 12px;
  }
  .neg-title {
    font-size: .64rem; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--neg-text);
    margin-bottom: 8px; display: flex; align-items: center; gap: 6px;
  }
  .neg-title::before { content: '✕'; font-size: .72rem; }
  .neg-grid { display: flex; flex-wrap: wrap; gap: 6px; }
  .neg-tag {
    background: rgba(255,60,60,.07);
    border: 1px solid rgba(255,60,60,.18);
    border-radius: 6px; padding: 4px 10px;
    font-size: .74rem; color: #FF9999;
  }

  /* Tip */
  .tip-box {
    background: var(--orange-dim);
    border: 1px solid rgba(255,98,0,.2);
    border-left: 3px solid var(--orange);
    border-radius: 10px; padding: 11px 13px;
    font-size: .79rem; color: #FFCFA0;
    line-height: 1.55; margin-top: 12px;
  }
  .tip-box strong { color: var(--orange); }

  /* Overview */
  .overview-intro {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 14px; padding: 15px; margin-bottom: 14px;
    display: flex; gap: 12px; align-items: flex-start;
  }
  .ov-icon { font-size: 1.5rem; flex-shrink: 0; }
  .ov-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .95rem; margin-bottom: 5px; }
  .ov-desc { font-size: .78rem; color: var(--muted); line-height: 1.55; }
  .ov-desc strong { color: var(--orange); }

  .legend { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
  .legend-item { display: flex; align-items: center; gap: 5px; font-size: .72rem; color: var(--muted); }
  .ldot { width: 8px; height: 8px; border-radius: 2px; }
  .ldot.hot { background: var(--orange); }
  .ldot.mid { background: #3282C8; }
  .ldot.low { background: var(--muted2); }

  .overview-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px,1fr)); gap: 11px; }
  .eq-card {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 13px; padding: 14px;
    transition: transform .2s, box-shadow .2s;
  }
  .eq-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,.4),0 0 0 1px rgba(255,98,0,.18); }
  .eq-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .eq-card-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: .92rem; }
  .eq-icon {
    font-size: 1.1rem; background: var(--orange-dim);
    border: 1px solid rgba(255,98,0,.2); border-radius: 7px;
    width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
  }
  .eq-kws { display: flex; flex-wrap: wrap; gap: 5px; }
  .eq-kw { background: rgba(255,255,255,.04); border: 1px solid var(--line); border-radius: 5px; padding: 3px 8px; font-size: .71rem; color: var(--muted); }
  .eq-kw.t { background: rgba(255,98,0,.1); border-color: rgba(255,98,0,.28); color: var(--hot-text); }

  @media (max-width: 400px) {
    .panel-title { font-size: 1.05rem; }
    .kw-tag { font-size: .74rem; padding: 5px 9px; }
    .content { padding: 12px 11px 24px; }
    .pill-btn { font-size: .74rem; }
  }
</style>
</head>
<body>

<!-- ══ LOGIN ══ -->
<div id="login-screen">
  <div class="login-box">

    <div class="login-title">Mind<span>Fly</span></div>
    <div class="login-subtitle">Painel de Marketing MindFly</div>
    <label class="login-label" for="pw">Senha de acesso</label>
    <input id="pw" class="login-input" type="password" placeholder="••••••••••" autocomplete="off"/>
    <div class="login-error" id="pw-err"></div>
    <button class="login-btn" onclick="doLogin()">Entrar no Painel</button>
  </div>
</div>

<!-- ══ DASHBOARD ══ -->
<div id="dashboard">

  <header class="header">
    <div class="brand">Mind<span>Fly</span></div>
    <div class="header-tag">Keywords</div>
  </header>

  <nav class="pill-nav">
    <div class="pill-grid">
      <button class="pill-btn active pill-overview" onclick="switchTab('overview',this)">Visão Geral</button>
      <button class="pill-btn" onclick="switchTab('morpheus',this)">Morpheus 8</button>
      <button class="pill-btn" onclick="switchTab('ultraformer',this)">Ultraformer MPT</button>
      <button class="pill-btn" onclick="switchTab('lavieen',this)">Lavieen</button>
      <button class="pill-btn" onclick="switchTab('co2',this)">CO2 / MTZ40</button>
    </div>
  </nav>

  <main class="content">

    <!-- VISÃO GERAL -->
    <div id="tab-overview" class="tab-panel active">
      <div class="overview-intro">
        <div class="ov-icon">🎯</div>
        <div>
          <div class="ov-title">Inteligência de Keywords — Locação de Equipamentos</div>
          <p class="ov-desc">Mapeamento das <strong>palavras-chave com maior potencial de conversão</strong> no Google Ads para locação de equipamentos dermatológicos. Termos ranqueados por intenção de compra — do mais quente ao complementar — para campanhas de alta performance.</p>
        </div>
      </div>
      <div class="legend">
        <div class="legend-item"><div class="ldot hot"></div> Alta Conversão</div>
        <div class="legend-item"><div class="ldot mid"></div> Média-Alta</div>
        <div class="legend-item"><div class="ldot low"></div> Complementar</div>
      </div>
      <div class="overview-grid">
        <div class="eq-card">
          <div class="eq-card-top"><div class="eq-card-name">Morpheus 8</div><div class="eq-icon">🔬</div></div>
          <div class="eq-kws">
            <span class="eq-kw t">locação Morpheus8</span>
            <span class="eq-kw t">aluguel Morpheus8</span>
            <span class="eq-kw t">alugar Morpheus 8</span>
            <span class="eq-kw">Morpheus8 clínica</span>
            <span class="eq-kw">RF microagulhamento</span>
          </div>
        </div>
        <div class="eq-card">
          <div class="eq-card-top"><div class="eq-card-name">Ultraformer MPT</div><div class="eq-icon">📡</div></div>
          <div class="eq-kws">
            <span class="eq-kw t">locação Ultraformer MPT</span>
            <span class="eq-kw t">aluguel Ultraformer MPT</span>
            <span class="eq-kw t">alugar Ultraformer MPT</span>
            <span class="eq-kw">HIFU clínica</span>
            <span class="eq-kw">ultrassom microfocado</span>
          </div>
        </div>
        <div class="eq-card">
          <div class="eq-card-top"><div class="eq-card-name">Lavieen</div><div class="eq-icon">✨</div></div>
          <div class="eq-kws">
            <span class="eq-kw t">locação Lavieen</span>
            <span class="eq-kw t">aluguel Lavieen</span>
            <span class="eq-kw t">locação laser Thulium</span>
            <span class="eq-kw">alugar laser Thulium</span>
            <span class="eq-kw">laser 1927nm</span>
          </div>
        </div>
        <div class="eq-card">
          <div class="eq-card-top"><div class="eq-card-name">CO2 / MTZ40</div><div class="eq-icon">⚡</div></div>
          <div class="eq-kws">
            <span class="eq-kw t">locação laser CO2 fracionado</span>
            <span class="eq-kw t">aluguel MTZ40</span>
            <span class="eq-kw t">locação MTZ40</span>
            <span class="eq-kw">locação CO2 clínica</span>
            <span class="eq-kw">laser CO2 médico</span>
          </div>
        </div>
      </div>
      <div class="tip-box" style="margin-top:14px">
        💡 <strong>Estrutura recomendada:</strong> 1 campanha por equipamento — grupos separados por correspondência <em>exata</em> e de <em>frase</em>. Navegue pelas abas para a lista completa com dicas estratégicas de cada equipamento.
      </div>
    </div>

    <!-- MORPHEUS 8 -->
    <div id="tab-morpheus" class="tab-panel">
      <div class="panel-header">
        <div class="panel-icon">🔬</div>
        <div>
          <div class="panel-title">Morpheus <span>8</span></div>
          <div class="panel-desc">RF fracionada · Microagulhamento · InMode · Minimamente invasivo</div>
        </div>
      </div>
      <div class="stats-row">
        <div class="stat-chip"><span class="s-icon">🔥</span><div class="s-num">6</div><div class="s-label">Alta Conv.</div></div>
        <div class="stat-chip"><span class="s-icon">⚡</span><div class="s-num">6</div><div class="s-label">Média-Alta</div></div>
        <div class="stat-chip"><span class="s-icon">💡</span><div class="s-num">4</div><div class="s-label">Complementar</div></div>
      </div>
      <div class="kw-section">
        <div class="kw-section-title">🔥 Alta Conversão</div>
        <div class="kw-grid">
          <span class="kw-tag hot">locação Morpheus8</span>
          <span class="kw-tag hot">aluguel Morpheus8</span>
          <span class="kw-tag hot">alugar Morpheus 8</span>
          <span class="kw-tag hot">locação Morpheus 8 clínica</span>
          <span class="kw-tag hot">aluguel Morpheus 8 médico</span>
          <span class="kw-tag hot">locação Morpheus8 por dia</span>
        </div>
      </div>
      <div class="kw-section">
        <div class="kw-section-title">⚡ Média-Alta Conversão</div>
        <div class="kw-grid">
          <span class="kw-tag mid">locação Morpheus8 dermatologista</span>
          <span class="kw-tag mid">alugar equipamento Morpheus8</span>
          <span class="kw-tag mid">locação Morpheus 8 procedimentos</span>
          <span class="kw-tag mid">Morpheus8 aluguel diário</span>
          <span class="kw-tag mid">locação Morpheus8 cirurgião plástico</span>
          <span class="kw-tag mid">aluguel Morpheus 8 radiofrequência</span>
        </div>
      </div>
      <div class="kw-section">
        <div class="kw-section-title">💡 Complementar</div>
        <div class="kw-grid">
          <span class="kw-tag low">locação RF microagulhamento Morpheus</span>
          <span class="kw-tag low">Morpheus8 locação mensal</span>
          <span class="kw-tag low">locação InMode Morpheus</span>
          <span class="kw-tag low">aluguel radiofrequência fracionada</span>
        </div>
      </div>
      <div class="neg-section">
        <div class="neg-title">Palavras-Chave Negativas</div>
        <div class="neg-grid">
          <span class="neg-tag">preço Morpheus8</span>
          <span class="neg-tag">quanto custa</span>
          <span class="neg-tag">resultado Morpheus8</span>
          <span class="neg-tag">antes e depois</span>
          <span class="neg-tag">clínica Morpheus8</span>
          <span class="neg-tag">sessão Morpheus</span>
          <span class="neg-tag">tratamento Morpheus</span>
          <span class="neg-tag">fazer Morpheus8</span>
        </div>
      </div>
      <div class="tip-box">💡 <strong>Dica:</strong> Use correspondência exata <code>[locação Morpheus8]</code> como grupo principal. Destaque <strong>suporte técnico + entrega inclusa</strong> — são os critérios decisivos do público médico.</div>
    </div>

    <!-- ULTRAFORMER MPT -->
    <div id="tab-ultraformer" class="tab-panel">
      <div class="panel-header">
        <div class="panel-icon">📡</div>
        <div>
          <div class="panel-title">Ultraformer <span>MPT</span></div>
          <div class="panel-desc">Ultrassom micro e macrofocado · Micro-Pulsed Technology · Lifting não cirúrgico</div>
        </div>
      </div>
      <div class="stats-row">
        <div class="stat-chip"><span class="s-icon">🔥</span><div class="s-num">6</div><div class="s-label">Alta Conv.</div></div>
        <div class="stat-chip"><span class="s-icon">⚡</span><div class="s-num">5</div><div class="s-label">Média-Alta</div></div>
        <div class="stat-chip"><span class="s-icon">💡</span><div class="s-num">4</div><div class="s-label">Complementar</div></div>
      </div>
      <div class="kw-section">
        <div class="kw-section-title">🔥 Alta Conversão</div>
        <div class="kw-grid">
          <span class="kw-tag hot">locação Ultraformer MPT</span>
          <span class="kw-tag hot">aluguel Ultraformer MPT</span>
          <span class="kw-tag hot">alugar Ultraformer MPT</span>
          <span class="kw-tag hot">locação Ultraformer MPT clínica</span>
          <span class="kw-tag hot">aluguel Ultraformer MPT médico</span>
          <span class="kw-tag hot">Ultraformer MPT locação por dia</span>
        </div>
      </div>
      <div class="kw-section">
        <div class="kw-section-title">⚡ Média-Alta Conversão</div>
        <div class="kw-grid">
          <span class="kw-tag mid">locação Ultraformer MPT dermatologia</span>
          <span class="kw-tag mid">aluguel Ultraformer MPT dermatologista</span>
          <span class="kw-tag mid">locação ultrassom microfocado MPT</span>
          <span class="kw-tag mid">aluguel Ultraformer cirurgião plástico</span>
          <span class="kw-tag mid">locação Ultraformer lifting não cirúrgico</span>
        </div>
      </div>
      <div class="kw-section">
        <div class="kw-section-title">💡 Complementar</div>
        <div class="kw-grid">
          <span class="kw-tag low">locação HIFU Ultraformer</span>
